/**
 * chronoscroll — Cloudflare Workers (static assets + R2)
 * https://developers.cloudflare.com/workers/static-assets/
 *
 * Everything in build/ except /e/ (94 files) is served as static assets,
 * and only /e/<id> (27,000+ prerendered HTML pages) is returned by the Worker from R2.
 * This split keeps us within the free tier's "20,000 files per version"; the HTML is
 * diff-synced from build/e to the R2 bucket by scripts/r2-sync.mjs.
 * The source of truth for security headers is config/security-headers.json (read by _headers and the Worker).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "chronoscroll",
	"main": "worker/index.ts",
	"compatibility_date": "2026-09-26",
	"assets": {
		"directory": "./build",
		"binding": "ASSETS",
		// There is no build/404.html, so in practice the Worker's notFound() returns the 404
		"not_found_handling": "404-page",
		// Only /e/* hits the Worker first. Everything else is resolved by static assets first
		"run_worker_first": ["/e/*"],
	},
	"r2_buckets": [
		{
			"binding": "PAGES",
			"bucket_name": "chronoscroll-pages",
		},
	],
	"observability": {
		"enabled": true,
	},
}
