{
  "name": "chronoscroll",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/write-headers.mjs && vite build && node scripts/externalize-inline.mjs && node scripts/split-pages.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p pipeline && tsc --noEmit -p worker",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "data:build": "tsx pipeline/run/build.ts",
    "ogp": "node scripts/gen-ogp.mjs",
    "r2:sync": "node --env-file=.env.r2 scripts/r2-sync.mjs",
    "deploy:check": "echo assets: $(find build -type f | wc -l) / pages: $(ls build-e | wc -l)"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "effect": "^4.0.5",
    "js-yaml": "^5.5.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.0",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
