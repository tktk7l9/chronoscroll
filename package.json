{
  "name": "chronoscroll",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/externalize-inline.mjs",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p pipeline",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "data:build": "tsx pipeline/run/build.ts",
    "ogp": "node scripts/gen-ogp.mjs"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "js-yaml": "^5.3.0",
    "playwright-core": "^1.63.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "minisearch": "^7.2.0"
  },
  "overrides": {
    "cookie": "^0.7.2"
  }
}
